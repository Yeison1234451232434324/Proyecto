# ── Servidor ──
PORT=3000

# ── Supabase ──
# URL del proyecto (Settings → API → Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (Settings → API → anon public)
SUPABASE_KEY=tu_anon_key_aqui

# Clave de servicio — NUNCA compartir públicamente (Settings → API → service_role)
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# ── Frontend ──
# URL donde corre el frontend (para el redirect de recuperar contraseña)
FRONTEND_URL=http://localhost:5173
